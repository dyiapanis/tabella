{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tabella": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/mcp_server.py"],
      "env": {}
    },
    "tabella_http": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8602/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_TABELL_HTTP_TOKEN"
      }
    }
  }
}